# ─── DEV local (versionable, sin secretos reales) ───
# Uso: docker compose --env-file .env.dev up --build
# Entrada: http://localhost:6060 (nginx → vite dev :5173 + backend :3001)

POSTGRES_PASSWORD=msm_dev_password
JWT_SECRET=dev-only-insecure-secret
JWT_EXPIRES_IN=7d
CORS_ORIGIN=http://localhost:6060,http://localhost:5173,http://nginx.my-school-my-parents.orb.local,https://nginx.my-school-my-parents.orb.local
LOG_LEVEL=debug

# Rangos de proxy de confianza para resolver la IP real del cliente desde
# X-Forwarded-For (lista separada por comas: presets de proxy-addr
# —loopback, linklocal, uniquelocal— o CIDRs sueltos).
# El valor por defecto confía en todas las direcciones privadas, que es
# donde viven nginx y el reverse proxy del host, y corta en la primera
# pública: esa es la IP real. Un XFF inyectado por el cliente queda a la
# izquierda y nunca se lee.
# Con un CDN por delante (Cloudflare y similares), añade aquí sus rangos o
# el rate limit contará a todos sus nodos como un solo cliente.
TRUST_PROXY=loopback,linklocal,uniquelocal

APP_PUBLIC_URL=http://localhost:6060

# Sin SMTP en dev: el backend no envía correo y escribe el código de
# recuperación en sus propios logs (`docker compose logs -f backend`).
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM="MySchoolMyParents (dev) <no-reply@localhost>"

# /api = el backend real a través del proxy del `vite dev`. Así el
# desarrollo recorre el mismo camino que producción y el mock no se
# oxida sin que nadie lo note.
# Para trabajar solo en el frontend sin backend ni base de datos, pon
# VITE_AUTH_API_URL= (vacío) en un frontend/.env.local y arranca con
# `npm run dev`: eso activa el mock de localStorage.
VITE_AUTH_API_URL=/api
VITE_GOOGLE_CLIENT_ID=
