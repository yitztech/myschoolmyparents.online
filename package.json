{
  "name": "myschoolmyparents",
  "version": "1.0.0",
  "private": true,
  "description": "MySchoolMyParents Online: fotos de lecturas escolares convertidas en libros bilingües con voz. Monorepo: web (React + NestJS) y app Flutter.",
  "scripts": {
    "up": "docker compose up -d --build",
    "up:logs": "docker compose up --build",
    "down": "docker compose down",
    "down:clean": "docker compose down -v",
    "logs": "docker compose logs -f",
    "ps": "docker compose ps",
    "install:all": "npm ci --prefix apps/backend && npm ci --prefix apps/frontend && npm ci --prefix apps/mobile && npm ci --prefix e2e",
    "build": "npm run build --prefix apps/backend && VITE_AUTH_API_URL=/api npm run build --prefix apps/frontend",
    "lint": "npm run lint --prefix apps/frontend",
    "test:backend": "npm test --prefix apps/backend",
    "test:frontend": "npm test --prefix apps/frontend",
    "test:mobile": "npm run mobile:test",
    "test:db": "node --import ./apps/backend/node_modules/tsx/dist/loader.mjs --test \"tests/database/*.test.ts\"",

    "test:unit": "npm run test:backend && npm run test:frontend && npm run test:mobile",
    "test:gherkin": "npm run test:gherkin --prefix e2e",
    "test:e2e": "npm test --prefix e2e",
    "test:all": "npm run test:backend && npm run test:frontend && npm run test:mobile && npm run test:db",
    "mobile:dev-certs": "docker compose -f docker/mobile-dev-certs/docker-compose.yml up --build",
    "mobile:test": "npm test --prefix apps/mobile && node --test scripts/test-mobile-scripts.mjs",
    "mobile": "npm run start --prefix apps/mobile",
    "mobile:typecheck": "npm run typecheck --prefix apps/mobile",
    "mobile:version": "node scripts/mobile-version.mjs",
    "mobile:impact": "node scripts/mobile-impact.mjs",
    "dev:doctor": "node scripts/dev-doctor.mjs",
    "dev:mail": "node -e 'const open = process.platform === \"darwin\" ? \"open\" : \"xdg-open\"; require(\"child_process\").execSync(`${open} http://localhost:8027`)'",
    "db:backup": "sh scripts/backup-db.sh",
    "db:restore": "sh scripts/restore-db.sh"
  },

  "engines": {
    "node": ">=24"
  }
}
