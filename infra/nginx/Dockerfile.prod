# Nginx PROD — imagen autónoma: build Vite + estáticos + proxy /api/.
# Contexto de build: la RAÍZ del repo (ver docker-compose.prod.yml).
#   docker compose -f docker-compose.yml -f docker-compose.prod.yml --env-file .env.prod up --build -d
# Ojo: VITE_* son build-time (Vite los hornea en el JS); cambiarlos exige reconstruir.
FROM node:24.20-alpine AS frontend-build
WORKDIR /app
COPY apps/frontend/package.json apps/frontend/package-lock.json ./
RUN npm ci && npm cache clean --force
COPY apps/frontend/ ./
ARG VITE_AUTH_API_URL=""
ARG VITE_GOOGLE_CLIENT_ID=""
ENV VITE_AUTH_API_URL=$VITE_AUTH_API_URL
ENV VITE_GOOGLE_CLIENT_ID=$VITE_GOOGLE_CLIENT_ID
RUN npm run build

FROM nginx:1.31-alpine
COPY --from=frontend-build /app/dist /usr/share/nginx/html
COPY infra/nginx/nginx.prod.conf /etc/nginx/conf.d/default.conf
COPY infra/nginx/security-headers.conf /etc/nginx/snippets/security-headers.conf
EXPOSE 80
