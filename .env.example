# ─── MySchoolMyParents — plantilla de entorno (raíz) ───
# Copia a `.env.dev` (valores inofensivos, versionable) o `.env.prod`
# (secretos reales, NO versionar; ver `.env.prod.example`, que es el
# contrato que rellena la plantilla de Ansible).
# Uso:
#   DEV:  docker compose --env-file .env.dev up --build
#   PROD: docker compose -f docker-compose.yml -f docker-compose.prod.yml --env-file .env.prod up --build -d

# PostgreSQL (dev: valor tonto; prod: secreto largo, p. ej. `openssl rand -base64 32`)
POSTGRES_PASSWORD=

# Backend (prod: JWT_SECRET obligatorio, sin default; genera con `openssl rand -base64 32`)
JWT_SECRET=
JWT_EXPIRES_IN=7d

# CORS del backend (lista separada por comas, sin espacios).
# Dev: http://localhost:6060,http://localhost:5173 + dominio(s) OrbStack.
# Prod: solo https://myschoolmyparents.online
CORS_ORIGIN=

# Nivel de log del backend (dev: debug; prod: info o warn)
LOG_LEVEL=

# Rangos de proxy de confianza para resolver la IP real del cliente desde
# X-Forwarded-For (lista separada por comas: presets de proxy-addr
# —loopback, linklocal, uniquelocal— o CIDRs sueltos).
# El valor por defecto confía en todas las direcciones privadas, que es
# donde viven nginx y el reverse proxy del host, y corta en la primera
# pública: esa es la IP real. Un XFF inyectado por el cliente queda a la
# izquierda y nunca se lee.
# Con un CDN por delante (Cloudflare y similares), añade aquí sus rangos o
# el rate limit contará a todos sus nodos como un solo cliente.
TRUST_PROXY=loopback,linklocal,uniquelocal

# URL pública, usada en el cuerpo de los correos.
APP_PUBLIC_URL=

# Correo transaccional por SMTP (en prod, el Stalwart del servidor).
# Vacío = no se envía nada y el código de recuperación sale por los logs
# (solo fuera de producción: en prod el arranque falla si falta).
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# Red Docker externa donde vive el servidor de correo (solo prod).
MAIL_NETWORK=

# Frontend (build-time Vite: cambiar de valor exige reconstruir la imagen).
# `/api` = backend real a través de nginx. Vacío = mock local de
# localStorage, SOLO para desarrollo sin backend: el build de producción
# falla a propósito si se queda vacío.
VITE_AUTH_API_URL=/api
VITE_GOOGLE_CLIENT_ID=
