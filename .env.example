# ─── MySchoolMyParents — entorno de DESARROLLO local (plantilla) ───
# Copia a `.env.dev` (ignorado por git) y arranca:
#   cp .env.example .env.dev
#   docker compose --env-file .env.dev up --build
# Entrada: http://localhost:6060 (nginx → vite dev :5173 + backend :3001)
#
# Estos valores son de juguete y el repositorio es público: no los uses
# NUNCA fuera de desarrollo. Producción no usa ningún .env: las variables
# las inyecta Coolify (ver docker-compose.prod.yml y el README).

POSTGRES_PASSWORD=msm_dev_password
# El backend se niega a arrancar en producción con un secreto que contenga
# "dev-only".
JWT_SECRET=dev-only-insecure-secret
JWT_EXPIRES_IN=7d
CORS_ORIGIN=http://localhost:6060,http://localhost:5173,http://nginx.my-school-my-parents.orb.local,https://nginx.my-school-my-parents.orb.local
LOG_LEVEL=debug

# Rangos de proxy de confianza para resolver la IP real del cliente desde
# X-Forwarded-For (lista separada por comas: presets de proxy-addr
# —loopback, linklocal, uniquelocal— o CIDRs sueltos).
# El valor por defecto confía en todas las direcciones privadas, que es
# donde viven los proxies internos, y corta en la primera pública: esa es
# la IP real. Un XFF inyectado por el cliente queda a la izquierda y nunca
# se lee.
TRUST_PROXY=loopback,linklocal,uniquelocal

APP_PUBLIC_URL=http://localhost:6060

# Sin SMTP en dev: el backend no envía correo y escribe el código de
# recuperación en sus propios logs (`docker compose logs -f backend`).
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM="MySchoolMyParents (dev) <no-reply@localhost>"

# /api = el backend real a través del proxy del `vite dev`. Así el
# desarrollo recorre el mismo camino que producción y el mock no se
# oxida sin que nadie lo note.
# Para trabajar solo en el frontend sin backend ni base de datos, pon
# VITE_AUTH_API_URL= (vacío) en un apps/frontend/.env.local y arranca con
# `npm run dev`: eso activa el mock de localStorage.
VITE_AUTH_API_URL=/api
VITE_GOOGLE_CLIENT_ID=

# OAuth con Google: credenciales del ID de cliente en Google Cloud Console.
# En dev, GOOGLE_REDIRECT_URI se resuelve solo a http://localhost:6060/api/auth/google/callback
# Vacíos = inicio de sesión con Google desactivado (responde 410).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=
