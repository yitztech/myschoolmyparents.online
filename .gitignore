# ——— Dependencias ———
node_modules/
apps/backend/node_modules/
apps/frontend/node_modules/
**/node_modules/

# ——— Builds ———
dist/
build/
dist-ssr/
apps/backend/dist/
apps/frontend/dist/
*.tsbuildinfo
apps/backend/*.tsbuildinfo
apps/frontend/*.tsbuildinfo

# ——— Env / secretos: ningún .env se versiona, salvo las plantillas *.example ———
# (en cualquier carpeta; producción no usa .env: las variables las pone Coolify)
.env*
!.env*.example

# ——— Logs ———
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# ——— Docker / datos locales ———
pgdata/
*.volume

# ——— Sistema / editores ———
.DS_Store
Thumbs.db
.vscode/*
!.vscode/extensions.json
.idea
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
*.local

# ——— Tests / cobertura ———
coverage/
.nyc_output/

# ——— Playwright ———
# Snapshots y logs de sesión que deja playwright-cli.
.playwright-cli/
# Artefactos de la suite e2e (trazas, capturas, informe HTML).
e2e/test-results/
e2e/playwright-report/
e2e/blob-report/

# ——— Vite / caches ———
.vite/
.turbo/
*.vite-inspect/
