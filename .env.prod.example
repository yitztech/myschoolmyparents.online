# ─── PROD (plantilla: la rellena Ansible sobre .env.prod, NO versionar) ───
# Uso: docker compose -f docker-compose.yml -f docker-compose.prod.yml --env-file .env.prod up --build -d
# Tras generarlo: chmod 600 .env.prod (contiene secretos).
# Genera secretos con: openssl rand -base64 32
#
# Este fichero es el CONTRATO de la plantilla de Ansible: cada variable
# marcada [vault] debe venir cifrada de Ansible Vault, nunca del repo.
# Ojo: VITE_* se hornean en el build (Vite); cambiarlos exige reconstruir
# con --build.

# ── Base de datos y sesión ──
# [vault]
POSTGRES_PASSWORD=CAMBIA_ESTE_PASSWORD_LARGO_Y_ALEATORIO
# [vault]
JWT_SECRET=CAMBIA_ESTE_SECRETO_LARGO_Y_ALEATORIO
JWT_EXPIRES_IN=7d
CORS_ORIGIN=https://myschoolmyparents.online
LOG_LEVEL=info

# ── Cadena de proxies ──
# Rangos de proxy de confianza para resolver la IP real del cliente desde
# X-Forwarded-For (lista separada por comas: presets de proxy-addr
# —loopback, linklocal, uniquelocal— o CIDRs sueltos).
# El valor por defecto confía en todas las direcciones privadas, que es
# donde viven nginx y el reverse proxy del host, y corta en la primera
# pública: esa es la IP real. Un XFF inyectado por el cliente queda a la
# izquierda y nunca se lee.
# Con un CDN por delante (Cloudflare y similares), añade aquí sus rangos o
# el rate limit contará a todos sus nodos como un solo cliente.
TRUST_PROXY=loopback,linklocal,uniquelocal

# URL pública (se usa en el cuerpo de los correos).
APP_PUBLIC_URL=https://myschoolmyparents.online

# ── Correo transaccional (Stalwart) ──
# Solo transaccional: las campañas van por Listmonk, con otra identidad de
# envío, para no mezclar reputaciones.
# SMTP_HOST es el nombre del servicio de Stalwart en la red Docker
# compartida (ver MAIL_NETWORK).
SMTP_HOST=stalwart
SMTP_PORT=587
# false = STARTTLS en el 587; true = TLS implícito en el 465.
SMTP_SECURE=false
# [vault]
SMTP_USER=no-reply@myschoolmyparents.online
# [vault]
SMTP_PASSWORD=CAMBIA_ESTA_CLAVE_SMTP
SMTP_FROM="MySchoolMyParents <no-reply@myschoolmyparents.online>"

# Red Docker externa donde vive Stalwart (debe existir ya: la crea el
# playbook que despliega el servidor de correo).
#   docker network ls | grep mail
MAIL_NETWORK=mail

# ── Frontend (build-time) ──
# /api = mismo origen a través de nginx. NUNCA dejar vacío en producción:
# el vacío activa el mock de localStorage y la autenticación deja de
# llegar al backend (el build falla a propósito si se queda vacío).
VITE_AUTH_API_URL=/api
VITE_GOOGLE_CLIENT_ID=
