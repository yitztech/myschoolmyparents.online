# URL del backend de autenticación en internet (REST).
# Ej.: VITE_AUTH_API_URL=https://api.tudominio.com
# Si se deja vacío, el frontend usa un mock local (localStorage) para
# probar login/registro/recuperación sin backend.
VITE_AUTH_API_URL=

# (Opcional, futuro) Client ID de Google para GIS en frontend.
# De momento el flujo recomendado es OAuth en el backend:
# GET {VITE_AUTH_API_URL}/auth/google
VITE_GOOGLE_CLIENT_ID=
