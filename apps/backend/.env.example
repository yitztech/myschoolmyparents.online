# ─── Backend — desarrollo nativo sin Docker (plantilla) ───
# Copia a `.env` (ignorado por git) y ajusta DATABASE_URL a tu PostgreSQL local.
# Con Docker Compose no hace falta: las variables las pone el compose.
# Uso: cd backend && npm install && npm run start:dev  (necesita DATABASE_URL)

NODE_ENV=development
PORT=3001
DATABASE_URL=postgres://msm:msm_dev_password@localhost:5432/myschoolmyparents
JWT_SECRET=dev-only-insecure-secret
JWT_EXPIRES_IN=7d
CORS_ORIGIN=http://localhost:6060,http://localhost:5173
LOG_LEVEL=debug
